# ==========================================
# Application
# ==========================================

NODE_ENV=development
PORT=3000


# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_support
POSTGRES_USER=smart_support_user
POSTGRES_PASSWORD=smart_support_password


# ==========================================
# MySQL
# ==========================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=legacy_orders
MYSQL_USER=legacy_user
MYSQL_PASSWORD=legacy_password


# ==========================================
# MongoDB
# ==========================================

MONGODB_URL=mongodb://localhost:27017/smart_support


# ==========================================
# RabbitMQ
# ==========================================

RABBITMQ_URL=amqp://smart_support:smart_support_password@localhost:5672


# ==========================================
# Qdrant
# ==========================================

QDRANT_URL=http://localhost:6333